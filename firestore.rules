rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      function owner(uid) { return request.auth != null && uid == request.auth.uid; }
      allow create: if owner(request.resource.data.userId);
      allow read, delete: if owner(resource.data.userId);
      allow update: if owner(resource.data.userId) && owner(request.resource.data.userId);
    }
  }
}
